# Copy this file to .env and fill in your Supabase project credentials.
# Never commit the real .env file — it is already covered by .gitignore's
# `.env*.local` rule, but double-check before committing.
#
# Where to get these values: Supabase Dashboard -> Project Settings -> API.
# These are prefixed with EXPO_PUBLIC_ because Expo only inlines env vars
# with that prefix into the client bundle. The anon key is safe to ship to
# the client — it has no privileges beyond what Row Level Security grants.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
